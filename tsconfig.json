{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@ymir-js/*": [
        "./packages/*/src/index.ts"
      ],
      "ymir-js": [
        "./packages/ymir-js/src/index.ts"
      ]
    }
  },
  "include": [
    "./packages/*/src/**/*"
  ]
}
