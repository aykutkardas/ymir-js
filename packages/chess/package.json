{
  "name": "@ymir-js/chess",
  "version": "0.11.0",
  "description": "Chess for ymir-js: every rule, FEN/SAN/UCI/PGN, perft-verified move generation and a small built-in engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutkardas/ymir-js.git",
    "directory": "packages/chess"
  },
  "homepage": "https://aykutkardas.github.io/ymir-js/",
  "keywords": [
    "chess",
    "fen",
    "pgn",
    "chess-engine",
    "board-game"
  ],
  "author": "Aykut Kardaş",
  "license": "MIT",
  "dependencies": {
    "@ymir-js/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
