{
  "name": "ymir-js",
  "version": "0.14.0",
  "description": "A TypeScript toolkit for board games: checkers, chess, Go and match-3 with full rules, on a small board core for your own games.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutkardas/ymir-js.git",
    "directory": "packages/ymir-js"
  },
  "homepage": "https://aykutkardas.github.io/ymir-js/",
  "keywords": [
    "board",
    "game",
    "toolkit",
    "checkers",
    "chess",
    "go",
    "match3"
  ],
  "author": "Aykut Kardaş",
  "license": "MIT",
  "dependencies": {
    "@ymir-js/core": "workspace:^",
    "@ymir-js/checkers": "workspace:^",
    "@ymir-js/chess": "workspace:^",
    "@ymir-js/go": "workspace:^",
    "@ymir-js/match3": "workspace:^"
  }
}
