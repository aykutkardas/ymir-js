{
  "name": "@ymir-js/checkers",
  "version": "0.12.0",
  "description": "Turkish and International checkers for ymir-js: full rules, capture chains, draws, undo and PDN notation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutkardas/ymir-js.git",
    "directory": "packages/checkers"
  },
  "homepage": "https://aykutkardas.github.io/ymir-js/",
  "keywords": [
    "checkers",
    "draughts",
    "dama",
    "board-game"
  ],
  "author": "Aykut Kardaş",
  "license": "MIT",
  "dependencies": {
    "@ymir-js/core": "workspace:^"
  },
