{
  "name": "@ymir-js/core",
  "version": "0.13.0",
  "description": "The ymir-js core: a typed board of squares and items, with movement patterns, directions and pathfinding, for building board games.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutkardas/ymir-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://aykutkardas.github.io/ymir-js/",
  "keywords": [
    "board",
    "game",
    "grid",
    "pathfinding",
    "toolkit"
  ],
  "author": "Aykut Kardaş",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
